# Default server / model for tool-eval-bench.
# Copy to .env and adjust for your setup.

# Option A: full URL (preferred)
# TOOL_EVAL_BASE_URL=http://your-server:8080

# Option B: host + port separately (used when BASE_URL is empty)
TOOL_EVAL_HOST=your-server
TOOL_EVAL_PORT=8080

# Backend label for reports (optional, default: vllm)
# All backends use the same OpenAI-compatible adapter — this is just a label.
# TOOL_EVAL_BACKEND=vllm

# Model name/path — leave empty for auto-detection from /v1/models
TOOL_EVAL_MODEL=

# API key — leave empty if not required
TOOL_EVAL_API_KEY=

# ---------------------------------------------------------------------------
# Named providers, for A/B runs from one .env.
#
# `tool-eval-bench run --provider gemini` (or TOOL_EVAL_PROVIDER=gemini) reads
# TOOL_EVAL_GEMINI_BASE_URL / _API_KEY / _MODEL instead of the generic values
# above. The name is free-form: VLLM_A and VLLM_B work as well as the vendor
# names. gemini, openai and anthropic also set the report's backend label and
# skip engine probing. --base-url, --api-key and --model still override.
# ---------------------------------------------------------------------------

# Gemini, native API (https://ai.google.dev/api/generate-content).
# Do not include /openai in the path: that is the OpenAI-compatible layer.
# TOOL_EVAL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# TOOL_EVAL_GEMINI_API_KEY=
# TOOL_EVAL_GEMINI_MODEL=gemini-2.5-pro

# OpenAI (https://developers.openai.com/api/reference).
# TOOL_EVAL_OPENAI_BASE_URL=https://api.openai.com
# TOOL_EVAL_OPENAI_API_KEY=
# TOOL_EVAL_OPENAI_MODEL=gpt-5

# Anthropic, through its OpenAI-compatible layer
# (https://platform.claude.com/docs/en/cli-sdks-libraries/libraries/openai-sdk).
# Set the model explicitly; /v1/models is not OpenAI-shaped there. Known gaps:
# response_format is silently ignored, so structured-output scenarios grade
# unconstrained text, and thinking is neither enabled nor returned.
# TOOL_EVAL_ANTHROPIC_BASE_URL=https://api.anthropic.com
# TOOL_EVAL_ANTHROPIC_API_KEY=
# TOOL_EVAL_ANTHROPIC_MODEL=claude-sonnet-5

# A second self-hosted box, for engine-vs-engine comparisons.
# TOOL_EVAL_LOCAL_BASE_URL=http://gpu-box:8080
